{
	"name": "squad-uplink",
	"description": "Squad-aware mobile web portal for GitHub Copilot CLI sessions",
	"version": "0.8.0",
	"author": "Shannon Fritz, Brian Swiger",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/swigerb/squad-uplink.git"
	},
	"type": "module",
	"engines": {
		"node": ">=22.5.0"
	},
	"main": "./dist/server.js",
	"bin": {
		"copilot-portal": "./bin/copilot-portal.mjs",
		"squad-uplink": "./bin/copilot-portal.mjs"
	},
	"files": [
		"dist/",
		"bin/",
		"examples/",
		"patch.mjs",
		"start-portal.cmd",
		"start-portal.sh",
		"BUILD"
	],
	"scripts": {
		"build": "node esbuild.cjs --production && cd webui && npm run build",
		"build:ext": "node esbuild.cjs",
		"build:ui": "cd webui && npm run build",
		"start": "node dist/launcher.js",
		"dev": "node esbuild.cjs --watch",
		"watch:ui": "cd webui && npm run dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node tools/test-client.mjs",
		"typecheck": "tsc --noEmit",
		"typecheck:all": "tsc --noEmit && cd webui && tsc --noEmit",
		"install:all": "npm install && cd webui && npm install",
		"package": "node package.mjs",
		"postinstall": "node patch.mjs"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/qrcode": "^1.5.5",
		"@types/ws": "^8.5.14",
		"esbuild": "^0.25.0",
		"typescript": "^5.0.0",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@bradygaster/squad-cli": "0.11.0",
		"@github/copilot": "1.0.69-3",
		"@github/copilot-sdk": "1.0.6-preview.1",
		"qrcode": "1.5.4",
		"qrcode-terminal": "^0.12.0",
		"ws": "8.21.0"
	}
}
